#!/bin/zsh
# Neovide launcher - Opens Neovide GUI independently from terminal
# Using macOS 'open' command to detach from terminal session

if [ $# -eq 0 ]; then
  # No arguments: open current directory
  # -n: Open a new instance even if one is already running
  # -a: Specify the application name
  # --args: Pass arguments to the application
  open -na Neovide --args "$(pwd)"
else
  # With arguments: pass them to neovide
  open -na Neovide --args "$@"
fi
